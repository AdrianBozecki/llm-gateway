{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(**/*.go)",
      "Write(**/*.go)",
      "Edit(**/*.sql)",
      "Write(**/*.sql)",
      "Edit(**/*.tf)",
      "Write(**/*.tf)",
      "Edit(**/*.tfvars)",
      "Write(**/*.tfvars)",
      "Edit(**/Dockerfile*)",
      "Write(**/Dockerfile*)",
      "Edit(**/Makefile)",
      "Write(**/Makefile)",
      "Edit(**/docker-compose*.yml)",
      "Write(**/docker-compose*.yml)",
      "Edit(/.github/**)",
      "Write(/.github/**)",
      "Edit(/.golangci.yml)",
      "Write(/.golangci.yml)",
      "Edit(/go.mod)",
      "Write(/go.mod)",
      "Edit(/go.sum)",
      "Write(/go.sum)",
      "Edit(/README.md)",
      "Write(/README.md)",
      "mcp__goland__create_new_file",
      "mcp__goland__apply_patch",
      "mcp__goland__rename_refactoring",
      "mcp__goland__reformat_file",
      "mcp__goland__optimize_imports",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ],
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go doc:*)",
      "Bash(golangci-lint run:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}
